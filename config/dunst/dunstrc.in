# variant @VARIANT@
[global]
    follow = mouse
    origin = top-right
    offset = 14x54
    width = (280, 420)
    height = 300
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 1
    gap_size = 6
    corner_radius = 10
    font = Ubuntu Sans 12
    markup = full
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = "Qogir-Ubuntu-Dark, Yaru, hicolor"
    highlight = "@ACCENT@"

[urgency_low]
    background = "@BG@"
    foreground = "@DIM@"
    frame_color = "@BORDER@"
    timeout = 5

[urgency_normal]
    background = "@BG@"
    foreground = "@FG@"
    frame_color = "@BORDER@"
    timeout = 8

[urgency_critical]
    background = "@BG@"
    foreground = "@FG@"
    frame_color = "@RED@"
    timeout = 0
