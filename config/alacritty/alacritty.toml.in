# mini-de, variant @VARIANT@

[window]
padding = { x = 12, y = 10 }
dynamic_padding = true

[font]
size = 14.0
normal = { family = "JetBrainsMono Nerd Font", style = "Regular" }
bold = { family = "JetBrainsMono Nerd Font", style = "Bold" }
italic = { family = "JetBrainsMono Nerd Font", style = "Italic" }
bold_italic = { family = "JetBrainsMono Nerd Font", style = "Bold Italic" }

[cursor]
style = { shape = "Block", blinking = "Off" }

[scrolling]
history = 20000

[selection]
save_to_clipboard = true

[colors.primary]
background = "@BG@"
foreground = "@FG@"

[colors.cursor]
text = "@BG@"
cursor = "@ACCENT_TEXT@"

[colors.selection]
text = "@HILITE_FG@"
background = "@HILITE@"

[colors.search]
matches = { foreground = "@SURFACE@", background = "@YELLOW@" }
focused_match = { foreground = "@SURFACE@", background = "@ORANGE@" }

[colors.normal]
black = "@RAISED@"
red = "@RED@"
green = "@GREEN@"
yellow = "@YELLOW@"
blue = "@BLUE@"
magenta = "@PURPLE@"
cyan = "@TEAL@"
white = "@FG@"

[colors.bright]
black = "@DIM@"
red = "@CLOSE_HOVER@"
green = "@GREEN_HI@"
yellow = "@YELLOW_HI@"
blue = "@BLUE@"
magenta = "@PURPLE@"
cyan = "@TEAL@"
white = "#ffffff"
