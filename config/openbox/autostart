#!/bin/sh
# Runs when the Openbox session starts

# Defaults; set your own in ~/.config/mini-de/local.conf
LAYOUTS=us; VARIANTS=; FLAT_MOUSE=; LOCK_COLOR=1d2021; DPI=96
WALLPAPER=/usr/share/backgrounds/warty-final-ubuntu.png
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
[ -r "$CONF/mini-de/colors.sh" ] && . "$CONF/mini-de/colors.sh"
[ -r "$CONF/mini-de/local.conf" ] && . "$CONF/mini-de/local.conf"

dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
    GTK_IM_MODULE QT_IM_MODULE XMODIFIERS
pkill -x ibus-daemon      # in case something started it anyway; see environment

"$CONF/openbox/monitors.sh"

# Like GNOME does: without it some programs (Alacritty, winit, Bevy) scale by the physical size of the screen
echo "Xft.dpi: $DPI" | xrdb -merge

# Keyboard layouts; they are switched by mini-de-shell
setxkbmap -layout "$LAYOUTS" -variant "$VARIANTS" -option ''
# Launcher on Super, windows on Alt+Tab, layouts on Super+Space; started again after a crash
(n=0; until "$HOME/.local/bin/mini-de-shell" || [ $((n += 1)) -ge 5 ]; do sleep 1; done) &

# Touchpad
for id in $(xinput list | grep -i touchpad | grep -o 'id=[0-9]*' | cut -d= -f2); do
    xinput set-prop "$id" 'libinput Tapping Enabled' 1
    xinput set-prop "$id" 'libinput Click Method Enabled' 1 0
    xinput set-prop "$id" 'libinput Disable While Typing Enabled' 1
done
# Mice without acceleration
if [ -n "$FLAT_MOUSE" ]; then
    for id in $(xinput list | grep -iE "$FLAT_MOUSE" | grep -o 'id=[0-9]*' | cut -d= -f2); do
        xinput set-prop "$id" 'libinput Accel Profile Enabled' 0 1 2>/dev/null ||
            xinput set-prop "$id" 'libinput Accel Profile Enabled' 0 1 0
    done
fi

xsettingsd &                                  # GTK theme, icons, cursor
xsetroot -cursor_name left_ptr
picom -b                                      # compositor
feh --no-fehbg --bg-fill "$WALLPAPER" &
lxpolkit &                                    # password prompts
dunst &                                       # notifications
xss-lock -- i3lock -n -c "${LOCK_COLOR#\#}" &             # lock on suspend
xset s 600 dpms 600 600 900

# Leftovers of the previous session. When its X server goes away, the portal tries to start its GTK part
# without a screen; the bus then waits 2 minutes for that, and Plank hangs waiting for the portal.
# Starting the services by hand, the GTK part first, ends the wait.
pkill -u "$(id -u)" -x plank
SERVICES="xdg-desktop-portal-gtk.service xdg-desktop-portal.service bamfdaemon.service"
timeout 3 systemctl --user stop $SERVICES 2>/dev/null
timeout 3 systemctl --user reset-failed $SERVICES 2>/dev/null
for s in $SERVICES; do timeout 5 systemctl --user start "$s" 2>/dev/null; done

pkill -u "$(id -u)" -f "$CONF/openbox/event-sounds.sh watch"

"$CONF/polybar/launch.sh" &
"$CONF/openbox/event-sounds.sh" watch &     # charger, battery, Bluetooth
"$CONF/openbox/event-sounds.sh" play login &
# Windows cannot get stuck under the panel, and have wide invisible borders for resizing
(n=0; until "$HOME/.local/bin/mini-de-wm" || [ $((n += 1)) -ge 5 ]; do sleep 1; done) &
(sleep 1; plank) &
