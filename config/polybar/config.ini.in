[colors]
bg = #e6@SURFACE_HEX@
bg-alt = @RAISED@
fg = @FG@
dim = @DIM@
accent = @ACCENT_TEXT@
red = @RED@
hot = @CLOSE@
cool = @GREEN@

[bar/base]
monitor = ${env:MONITOR:}
width = 100%
height = 40
background = ${colors.bg}
foreground = ${colors.fg}
padding = 2
module-margin = 2
font-0 = "Ubuntu Sans:size=14;4"
font-1 = "FontAwesome:size=15;4"
modules-left = title
modules-center = date
enable-ipc = true
wm-restack = generic
cursor-click = pointer

[bar/main]
inherit = bar/base
modules-right = cpu memory pulse backlight keyboard wlan profile battery tray power

[bar/side]
inherit = bar/base
modules-right = pulse keyboard battery

[module/workspaces]
type = internal/xworkspaces
label-active = %index%
label-active-background = ${colors.bg-alt}
label-active-foreground = ${colors.accent}
label-active-padding = 2
label-occupied = %index%
label-occupied-padding = 2
label-urgent = %index%
label-urgent-foreground = ${colors.red}
label-urgent-padding = 2
label-empty = %index%
label-empty-foreground = ${colors.dim}
label-empty-padding = 2

[module/title]
type = internal/xwindow
label = %title:0:60:...%
label-foreground = ${colors.dim}

[module/date]
type = internal/date
interval = 1
date = %a %d %b
time = %H:%M
label = %date%  %time%

[module/cpu]
type = internal/cpu
interval = 2
label = CPU %percentage%%

[module/memory]
type = internal/memory
interval = 3
label = RAM %percentage_used%%

[module/pulse]
type = internal/pulseaudio
format-volume = <ramp-volume> <label-volume>
label-volume = %percentage%%
label-muted =  muted
label-muted-foreground = ${colors.dim}
ramp-volume-0 = 
ramp-volume-1 = 
ramp-volume-2 = 
click-right = gnome-control-center sound

[module/backlight]
type = internal/backlight
card = ${env:BACKLIGHT:intel_backlight}
use-actual-brightness = true
enable-scroll = false
label =  %percentage%%

[module/keyboard]
type = internal/xkeyboard
blacklist-0 = num lock
blacklist-1 = scroll lock
label-layout =  %layout%

[module/wlan]
type = internal/network
interface-type = wireless
interval = 5
label-connected =  %essid%
label-disconnected =  off
label-disconnected-foreground = ${colors.dim}

[module/profile]
type = custom/script
exec-if = busctl --system get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile
exec = ~/.config/openbox/power-profile.sh watch
tail = true
env-HOT = ${colors.hot}
env-COOL = ${colors.cool}
click-left = ~/.config/openbox/power-profile.sh next &
click-right = ~/.config/openbox/power-profile.sh menu &

[module/battery]
type = internal/battery
battery = ${env:BATTERY:BAT0}
adapter = ${env:ADAPTER:AC}
full-at = 98
low-at = 15
label-charging =  %percentage%%
label-discharging =  %percentage%%
label-full =  %percentage%%
label-low =  %percentage%%
label-low-foreground = ${colors.red}

[module/tray]
type = internal/tray
tray-spacing = 6px

[module/power]
type = custom/text
format = 
format-foreground = ${colors.red}
click-left = ~/.config/openbox/powermenu.sh
