; mini-de panel. Icons come from Symbols Nerd Font, colors from the variant.
[colors]
bg = #e6@SURFACE_HEX@
bg-alt = @RAISED@
fg = @FG@
dim = @DIM@
accent = @ACCENT_TEXT@
blue = @BLUE@
green = @GREEN@
yellow = @YELLOW@
purple = @PURPLE@
teal = @TEAL@
orange = @ORANGE@
red = @RED@
hot = @CLOSE@
cool = @GREEN@

[bar/base]
monitor = ${env:MONITOR:}
width = 100%
height = 40
background = ${colors.bg}
foreground = ${colors.fg}
padding = 2
module-margin = 0
font-0 = "Inter:style=Medium:size=13;3"
font-1 = "Symbols Nerd Font:size=15;3"
font-2 = "Inter:style=SemiBold:size=13;3"
font-3 = "DejaVu Sans Mono:size=10;2"
modules-left = cpu memory sep backlight pulse mic
modules-center = date
enable-ipc = true
wm-restack = generic
cursor-click = pointer

[bar/main]
inherit = bar/base
modules-right = tray sep keyboard wlan bluetooth sep profile battery sep power

[bar/side]
inherit = bar/base
modules-right = keyboard battery

[module/sep]
type = custom/text
format = │
format-foreground = @BORDER@
format-padding = 1

; ── left ──
[module/cpu]
type = internal/cpu
interval = 1.5
format = <label> <ramp-coreload>
format-prefix = " "
format-prefix-font = 2
format-prefix-foreground = ${colors.blue}
format-padding = 1
label = %percentage%%
ramp-coreload-spacing = 0
ramp-coreload-font = 4
ramp-coreload-0 = ▁
ramp-coreload-1 = ▂
ramp-coreload-2 = ▃
ramp-coreload-3 = ▄
ramp-coreload-4 = ▅
ramp-coreload-5 = ▆
ramp-coreload-6 = ▇
ramp-coreload-7 = █
ramp-coreload-0-foreground = ${colors.blue}
ramp-coreload-1-foreground = ${colors.blue}
ramp-coreload-2-foreground = ${colors.teal}
ramp-coreload-3-foreground = ${colors.teal}
ramp-coreload-4-foreground = ${colors.yellow}
ramp-coreload-5-foreground = ${colors.yellow}
ramp-coreload-6-foreground = ${colors.orange}
ramp-coreload-7-foreground = ${colors.red}

[module/memory]
type = internal/memory
interval = 3
format-prefix = " "
format-prefix-font = 2
format-prefix-foreground = ${colors.purple}
format-padding = 1
label = %percentage_used%%

[module/backlight]
type = internal/backlight
card = ${env:BACKLIGHT:intel_backlight}
use-actual-brightness = true
enable-scroll = false
; scrolling goes through logind: polybar itself may not write to sysfs
format = %{A4:~/.config/openbox/brightness.sh up:}%{A5:~/.config/openbox/brightness.sh down:}<ramp> <label>%{A}%{A}
format-padding = 1
label = %percentage%%
ramp-0 = 󰃞
ramp-1 = 󰃟
ramp-2 = 󰃠
ramp-font = 2
ramp-foreground = ${colors.yellow}

[module/pulse]
type = internal/pulseaudio
; scrolling stops at 100 % instead of 153 %
use-ui-max = false
format-volume = <ramp-volume> <label-volume>
format-volume-padding = 1
label-volume = %percentage%%
format-muted = <label-muted>
format-muted-prefix = "󰖁 "
format-muted-prefix-font = 2
format-muted-foreground = ${colors.dim}
format-muted-padding = 1
label-muted = %percentage%%
ramp-volume-0 = 󰕿
ramp-volume-1 = 󰖀
ramp-volume-2 = 󰕾
ramp-volume-font = 2
ramp-volume-foreground = ${colors.teal}
click-right = ~/.local/bin/mini-de-settings sound &

[module/mic]
type = custom/script
exec = ~/.config/openbox/mic.sh
tail = true
format-padding = 1
env-NORMAL = ${colors.purple}
env-DIM = ${colors.dim}
click-left = pactl set-source-mute @DEFAULT_SOURCE@ toggle
click-right = ~/.local/bin/mini-de-settings sound &
scroll-up = ~/.config/openbox/volume.sh up 5 source
scroll-down = ~/.config/openbox/volume.sh down 5 source

; ── center ──
[module/date]
type = internal/date
interval = 1
date = %a %d %b
time = %H:%M
date-alt = %A, %d %B %Y
time-alt = %H:%M:%S
format = <label>
format-padding = 1
label = "%{T2}%{F@BLUE@}󰃭%{F-}%{T-} %date%   %{T2}%{F@TEAL@}󰥔%{F-}%{T-} %{T3}%time%%{T-}"

; ── right ──
[module/tray]
type = internal/tray
format-padding = 1
tray-spacing = 6px
tray-size = 46%

[module/keyboard]
type = internal/xkeyboard
blacklist-0 = num lock
blacklist-1 = scroll lock
blacklist-2 = caps lock
format = <label-layout>
format-prefix = "󰌌 "
format-prefix-font = 2
format-prefix-foreground = ${colors.orange}
format-padding = 1
label-layout = %layout%

[module/wlan]
type = internal/network
interface-type = wireless
interval = 5
format-connected = %{A1:~/.local/bin/mini-de-menu wifi &:}<ramp-signal>%{A}
format-connected-padding = 1
format-disconnected = %{A1:~/.local/bin/mini-de-menu wifi &:}<label-disconnected>%{A}
format-disconnected-foreground = ${colors.dim}
format-disconnected-padding = 1
label-disconnected = 󰤭
label-disconnected-font = 2
ramp-signal-0 = 󰤟
ramp-signal-1 = 󰤢
ramp-signal-2 = 󰤥
ramp-signal-3 = 󰤨
ramp-signal-font = 2
ramp-signal-foreground = ${colors.blue}

[module/bluetooth]
type = custom/script
exec = ~/.config/openbox/bluetooth.sh
tail = true
format-font = 2
format-padding = 1
env-NORMAL = ${colors.blue}
env-ACTIVE = ${colors.teal}
env-DIM = ${colors.dim}
click-left = ~/.local/bin/mini-de-menu bluetooth &

[module/profile]
type = custom/script
exec-if = busctl --system get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile
exec = ~/.config/openbox/power-profile.sh watch
tail = true
format-font = 2
format-padding = 1
env-HOT = ${colors.hot}
env-COOL = ${colors.cool}
click-left = ~/.config/openbox/power-profile.sh next &
click-right = ~/.config/openbox/power-profile.sh menu &

[module/battery]
type = custom/script
exec-if = [ -r /sys/class/power_supply/${BATTERY:-BAT0}/capacity ]
exec = ~/.config/openbox/battery.sh
tail = true
format-padding = 1
env-NORMAL = ${colors.green}
env-WARN = ${colors.yellow}
env-LOW = ${colors.orange}
env-CRIT = ${colors.red}
env-ON_CRIT = @SURFACE@

[module/power]
type = custom/text
format = 󰐥
format-font = 2
format-foreground = ${colors.red}
format-padding = 1
click-left = ~/.config/openbox/powermenu.sh
