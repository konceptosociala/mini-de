!! Template: install.sh --variant fills in the @...@ colors
!! Gruvbox-Round: round buttons. Without the picom shader they are just pixelated.
border.width: 1
padding.width: @TITLE_PADX@
padding.height: @TITLE_PADY@
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap: 0
menu.border.width: 1

window.active.border.color: @BORDER@
window.inactive.border.color: @BORDER_INACTIVE@
window.active.title.separator.color: @BG@
window.inactive.title.separator.color: @BG_INACTIVE@
window.active.client.color: @BG@
window.inactive.client.color: @BG_INACTIVE@

window.active.title.bg: flat solid
window.active.title.bg.color: @BG@
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: @BG_INACTIVE@
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: @FG@
window.inactive.label.text.color: @DIM@
window.label.text.justify: center

window.*.button.*.bg: parentrelative
window.active.button.close.unpressed.image.color: @CLOSE@
window.active.button.close.hover.image.color: @CLOSE_HOVER@
window.active.button.close.pressed.image.color: @CLOSE_PRESSED@
window.active.button.max.unpressed.image.color: @MAX@
window.active.button.max.hover.image.color: @MAX_HOVER@
window.active.button.max.pressed.image.color: @MAX_PRESSED@
window.active.button.max.toggled.unpressed.image.color: @MAX@
window.active.button.max.toggled.hover.image.color: @MAX_HOVER@
window.active.button.max.toggled.pressed.image.color: @MAX_PRESSED@
window.active.button.iconify.unpressed.image.color: @ICONIFY@
window.active.button.iconify.hover.image.color: @ICONIFY_HOVER@
window.active.button.iconify.pressed.image.color: @ICONIFY_PRESSED@
window.active.button.*.disabled.image.color: @BTN_OFF@
window.inactive.button.*.unpressed.image.color: @BTN_OFF@
window.inactive.button.*.toggled.unpressed.image.color: @BTN_OFF@
window.inactive.button.*.disabled.image.color: @BTN_DISABLED@
window.inactive.button.close.hover.image.color: @CLOSE_HOVER@
window.inactive.button.max.hover.image.color: @MAX_HOVER@
window.inactive.button.max.toggled.hover.image.color: @MAX_HOVER@
window.inactive.button.iconify.hover.image.color: @ICONIFY_HOVER@
window.inactive.button.close.pressed.image.color: @CLOSE_PRESSED@
window.inactive.button.max.pressed.image.color: @MAX_PRESSED@
window.inactive.button.iconify.pressed.image.color: @ICONIFY_PRESSED@

menu.border.color: @BORDER@
menu.title.bg: flat solid
menu.title.bg.color: @RAISED@
menu.title.text.color: @ACCENT_TEXT@
menu.title.text.justify: center
menu.items.bg: flat solid
menu.items.bg.color: @BG@
menu.items.text.color: @FG@
menu.items.disabled.text.color: @DIM@
menu.items.active.bg: flat solid
menu.items.active.bg.color: @HILITE@
menu.items.active.text.color: @HILITE_FG@
menu.separator.color: @BORDER@

osd.border.width: 1
osd.border.color: @BORDER@
osd.bg: flat solid
osd.bg.color: @BG@
osd.label.text.color: @FG@
osd.active.label.bg: flat solid
osd.active.label.bg.color: @HILITE@
osd.active.label.text.color: @HILITE_FG@
osd.hilight.bg: flat solid
osd.hilight.bg.color: @ACCENT@
